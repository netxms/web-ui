# Only the default brand and the Vite mode files listed here are tracked: any other
# src/brands/<id>/ and its .env.<id> stay local.
/src/brands/*/
!/src/brands/__tests__/
!/src/brands/netxms/

# Enterprise modules are separate private checkouts at src/modules/<id>/; only the registry's
# own tests are tracked here.
/src/modules/*/
!/src/modules/__tests__/
/.env.*
!/.env.demo
!/.env.development
!/.env.production
