# Demo build: yarn build --mode demo. A production bundle (Vite still builds with
# NODE_ENV=production) that adds the demo content release builds leave out: demo maps 600-603,
# demo dashboards 700-703 and the map demo toolbar. A private build adds module checkouts with
# VITE_MODULES (and VITE_FORCE_MODULES) on the command line.
VITE_API_BASE_URL=/api
VITE_BUILD_VARIANT=default
VITE_DEMO_CONTENT=true
