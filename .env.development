VITE_API_BASE_URL=/api
VITE_BUILD_VARIANT=default
# Dev-server proxy target for /api; override in .env.local (defaults to http://localhost:8000)
# VITE_API_TARGET=https://your-netxms-server/api
# Serve /api from the fixtures in mocks/ instead of a real server
# VITE_USE_MOCKS=true
# Demo maps/dashboards and demo toolbar; enabled unless set to false
# VITE_DEMO_CONTENT=true
# Enterprise modules compiled into this build (folders under src/modules/); none unless set
# VITE_MODULES=example
# Treat these compiled-in modules as present even when the server does not report them.
# Mock runs with a module need it: mock server-info lists no modules
# VITE_FORCE_MODULES=example
