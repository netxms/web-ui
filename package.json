{
  "name": "netxms-ui-redesign",
  "version": "0.9.0",
  "license": "GPL-2.0-or-later",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:parity": "vitest run src/__tests__/dashboardParity.live.spec.js src/__tests__/networkMapParity.live.spec.js",
    "test:e2e": "playwright test --grep-invert @gallery",
    "test:e2e:gallery": "playwright test --grep @gallery",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix && node scripts/lint-modules.mjs --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:ci": "run-s \"lint:ci:*\"",
    "lint:ci:oxlint": "oxlint . && node scripts/lint-modules.mjs",
    "lint:ci:eslint": "eslint .",
    "format": "oxfmt src/",
    "pull": "echo core; git pull --rebase && sh -c 'for r in $(find src/modules -depth 1 -type dl ! -name __tests__); do echo $r; git -C \"$r\" pull --rebase; done'"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/arimo": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@lezer/highlight": "^1.2.5",
    "@primeuix/themes": "^2.0.3",
    "@tanstack/vue-query": "^5.105.0",
    "@vue/devtools-api": "^8.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "cytoscape": "^3.34.4",
    "cytoscape-cola": "^2.5.1",
    "cytoscape-dagre": "^4.0.1",
    "cytoscape-leaflet": "^1.0.15",
    "dompurify": "^3.4.17",
    "driver.js": "^1.10.2",
    "echarts": "^6.1.0",
    "grid-layout-plus": "^1.1.1",
    "leaflet": "^1.9.4",
    "leaflet-editable": "^1.3.2",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.1.2",
    "pinia": "^4.1.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "qrcode": "^1.5.4",
    "three": "^0.187.0",
    "vue": "^3.5.44",
    "vue-codemirror": "^6.1.1",
    "vue-echarts": "^8.3.2",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.90.0",
    "eslint-plugin-vue": "~10.12.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.75.0",
    "oxlint": "~1.90.0",
    "postcss-rtlcss": "^6.0.0",
    "vite": "^8.3.5",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "resolutions": {
    "vue": "beta",
    "@vue/compiler-core": "beta",
    "@vue/compiler-dom": "beta",
    "@vue/compiler-sfc": "beta",
    "@vue/compiler-ssr": "beta",
    "@vue/compiler-vapor": "beta",
    "@vue/reactivity": "beta",
    "@vue/runtime-core": "beta",
    "@vue/runtime-dom": "beta",
    "@vue/runtime-vapor": "beta",
    "@vue/server-renderer": "beta",
    "@vue/shared": "beta",
    "@vue/compat": "beta",
    "@codemirror/language": "6.12.1",
    "@lezer/common": "1.5.1"
  }
